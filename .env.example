# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file — it's already listed in .gitignore.

# MongoDB Atlas connection string (enables login/signup + scan history)
MONGO_URI=your_mongodb_atlas_connection_string_here

# Database name (optional — defaults to agrismart_db if unset)
DB_NAME=agrismart_db

# Groq API key (enables the AI chatbot + weather advisory text)
GROQ_API_KEY=your_groq_api_key_here

# Optional — override the default Groq model
GROQ_MODEL=openai/gpt-oss-120b

# Set to "false" in production (Render, etc.) to disable Flask's debug mode
FLASK_DEBUG=true
